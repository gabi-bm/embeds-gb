# `npm run setup` generates a real .env for you (per-worktree DB name, your
# local OS username as the Postgres role) — you shouldn't need to edit this
# by hand. Shown here so every variable the app reads is documented.

# postgres://<your-username>@localhost:5432/higherlower_<worktree-dir-name>
DATABASE_URL=postgres://localhost:5432/higherlower_dev

# API server port. Pick an unused one per parallel session, e.g. PORT=4001.
PORT=4000
